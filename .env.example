# Public values only. Never prefix server secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only keys
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=
# Optional: without these, outreach uses an evidence-based template.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Set the exact production origin; used for billing redirects and origin checks.
APP_URL=http://localhost:3000
# Enable discovery only after Google billing is restored.
GOOGLE_PLACES_ENABLED=false
# Server-only Paystack config. Start with test mode; never expose the secret key.
# Keep disabled until USD approval, webhook, and payment lifecycle tests are complete.
PAYSTACK_BILLING_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_STARTER_MONTHLY=
PAYSTACK_PLAN_STARTER_YEARLY=
PAYSTACK_PLAN_GROWTH_MONTHLY=
PAYSTACK_PLAN_GROWTH_YEARLY=
PAYSTACK_PLAN_AGENCY_MONTHLY=
PAYSTACK_PLAN_AGENCY_YEARLY=
