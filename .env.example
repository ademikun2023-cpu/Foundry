# Public values only. Never prefix server secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only keys
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=
# Optional: without these, outreach uses an evidence-based template.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Set the exact production origin; used for billing redirects and origin checks.
APP_URL=http://localhost:3000
# Billing stays disabled until every value is configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=
